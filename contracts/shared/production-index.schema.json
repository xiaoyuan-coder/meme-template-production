{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.memebuy.cn/production-index-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "items"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "skill", "state", "revision", "stage", "artifacts"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "skill": {"enum": ["meme-template-image-producer", "meme-template-json-compiler"]},
          "state": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1},
          "stage": {"type": "string", "minLength": 1},
          "errorCode": {"type": ["string", "null"]},
          "recoveryAction": {"type": ["string", "null"]},
          "artifacts": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^(artifact|delivery|sidecar)://"}
          }
        }
      }
    }
  }
}
