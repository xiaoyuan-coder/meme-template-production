{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.memebuy.cn/template-image-oss-receipt-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvedImageSha256", "objectDigest", "byteLength", "objectKey",
    "remoteIdentity", "requestIdentity", "publicHttpsUrl", "providerReceipt",
    "providerReceiptDigest", "uploadedAt"
  ],
  "properties": {
    "approvedImageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objectDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "byteLength": {"type": "integer", "minimum": 1},
    "objectKey": {"type": "string", "pattern": "^gallery/template-images/[a-f0-9]{64}\\.png$"},
    "remoteIdentity": {"type": "string", "minLength": 1},
    "requestIdentity": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publicHttpsUrl": {
      "type": "string", "format": "uri",
      "pattern": "^https://assets\\.memebuy\\.cn/gallery/template-images/[a-f0-9]{64}\\.png$"
    },
    "providerReceipt": {"type": "object"},
    "providerReceiptDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uploadedAt": {"type": "string", "format": "date-time"}
  }
}
