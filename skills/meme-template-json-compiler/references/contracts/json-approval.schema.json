{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.memebuy.cn/json-approval-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision", "objectSha256", "approvedImageSha256", "reviewerRef",
    "decidedAt", "ruleVersion", "revision"
  ],
  "properties": {
    "decision": {"const": "APPROVED"},
    "objectSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approvedImageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewerRef": {"type": "string", "minLength": 1},
    "decidedAt": {"type": "string", "format": "date-time"},
    "ruleVersion": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1}
  }
}
