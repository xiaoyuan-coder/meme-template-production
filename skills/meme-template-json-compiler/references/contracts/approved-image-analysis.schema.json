{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.memebuy.cn/approved-image-analysis-v7.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "approvedImageSha256", "visualMechanism", "templateValue", "playDecisionModel", "componentGraph",
    "identityTopology", "textRegions", "mediumComposition", "spatialRelations",
    "containers", "fixedStructure", "editableCandidates", "editableFactRouting", "slotCoverageReview", "counts", "fieldEvidence",
    "titleEvidence", "descriptionEvidence", "taggingProfile", "tagEvidence", "slotEvidence", "promptCoverage",
    "translationEquivalences", "semanticModel", "selfReview", "warnings"
  ],
  "properties": {
    "schemaVersion": {"const": 7},
    "approvedImageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "visualMechanism": {"type": "string", "minLength": 1},
    "templateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whySelected", "templateHook", "fixedMechanism", "backendOnlyFacts"],
      "properties": {
        "whySelected": {"type": "string", "minLength": 1},
        "templateHook": {"type": "string", "minLength": 1},
        "fixedMechanism": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "backendOnlyFacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "playDecisionModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funProposition", "userRecreationWish", "coreUserDecisions"],
      "properties": {
        "funProposition": {"type": "string", "minLength": 1},
        "userRecreationWish": {"type": "string", "minLength": 1},
        "coreUserDecisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decisionId", "description", "slotId", "evidence"],
            "properties": {
              "decisionId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "description": {"type": "string", "minLength": 1},
              "slotId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "componentGraph": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "identityTopology": {"type": "array", "items": {"type": "object"}},
    "textRegions": {"type": "array", "items": {"type": "object"}},
    "mediumComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["medium", "styleTraits", "composition", "colorAndLight"],
      "properties": {
        "medium": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"},
        "styleTraits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"}},
        "composition": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"}},
        "colorAndLight": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"}}
      }
    },
    "spatialRelations": {"type": "array", "items": {"type": "object"}},
    "containers": {"type": "array", "items": {"type": "object"}},
    "fixedStructure": {"type": "array", "minItems": 1},
    "editableCandidates": {"type": "array", "items": {"type": "object"}},
    "editableFactRouting": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factId", "axis", "owner", "promptTerms", "forbiddenRuntimeTerms",
          "requiredTargetIds", "evidence"
        ],
        "properties": {
          "factId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "axis": {
            "enum": [
              "identity", "text", "content", "color", "shape", "material", "pattern",
              "background", "clothing", "prop", "action", "composition"
            ]
          },
          "owner": {"enum": ["prompt", "slot"]},
          "slotId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "promptTerms": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "forbiddenRuntimeTerms": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "requiredTargetIds": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {"type": "string", "minLength": 1}
        },
        "allOf": [{
          "if": {"properties": {"owner": {"const": "slot"}}},
          "then": {
            "required": ["slotId"],
            "properties": {"requiredTargetIds": {"minItems": 1}}
          },
          "else": {
            "not": {"required": ["slotId"]},
            "properties": {"requiredTargetIds": {"maxItems": 0}}
          }
        }]
      }
    },
    "slotCoverageReview": {"type": "object"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityCount", "visualInstanceCount", "uploadAssetCount", "inputControlCount"],
      "properties": {
        "identityCount": {"type": "integer", "minimum": 0},
        "visualInstanceCount": {"type": "integer", "minimum": 0},
        "uploadAssetCount": {"type": "integer", "minimum": 0},
        "inputControlCount": {"type": "integer", "minimum": 0}
      }
    },
    "fieldEvidence": {"type": "object"},
    "titleEvidence": {"type": "object"},
    "descriptionEvidence": {"type": "object"},
    "taggingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchProfile", "keywords", "hiddenTags"],
      "properties": {
        "matchProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subjects", "sourceImageType"],
          "properties": {
            "subjects": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["subjectKey", "memberCount"],
                "properties": {
                  "subjectKey": {"enum": ["person", "pet.cat", "pet.dog", "pet.rabbit", "pet.bird", "pet.hamster", "pet.other", "food", "object", "scenery", "text_image", "other"]},
                  "memberCount": {"type": "integer", "minimum": 0}
                }
              }
            },
            "sourceImageType": {"enum": ["non_identity", "single_identity", "group_identity", "multi_identity_composite"]}
          }
        },
        "keywords": {
          "type": "array", "minItems": 4, "maxItems": 6, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 12}
        },
        "hiddenTags": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["人物", "动物", "二次元", "粉丝应援", "情侣", "亲子家庭", "美食", "风景建筑", "搞怪meme", "文字设计", "创意艺术"]}
        }
      }
    },
    "tagEvidence": {"type": "object"},
    "slotEvidence": {"type": "object"},
    "promptCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allEditableContentCovered", "slotIds", "freeEditableRegionIds",
        "editableFactIds", "visualElementRoutes"
      ],
      "properties": {
        "allEditableContentCovered": {"const": true},
        "slotIds": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "freeEditableRegionIds": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "editableFactIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "visualElementRoutes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "route", "evidence"],
            "properties": {
              "componentId": {"type": "string", "minLength": 1},
              "route": {"enum": ["slot", "prompt", "visual_contract", "remove"]},
              "slotId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "factIds": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
              },
              "contractFields": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["medium", "styleTraits", "composition", "relations", "colorAndLight"]}
              },
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "translationEquivalences": {"type": "array", "items": {"type": "object"}},
    "semanticModel": {"type": "object"},
    "selfReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedDraftSha256", "checks", "issuesFound", "revisionsApplied"],
      "properties": {
        "status": {"const": "PASS"},
        "reviewedDraftSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "evidence"],
            "properties": {
              "passed": {"const": true},
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "issuesFound": {"type": "array", "maxItems": 0},
        "revisionsApplied": {"type": "array"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "object"}}
  }
}
