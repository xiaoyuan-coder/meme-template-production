{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.memebuy.cn/template-json-review-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state", "approvedImage", "frozenCandidateKey", "registry", "assetState", "analysisSummary", "templateValue",
    "titleEvidence", "tagEvidence", "slotCards", "copy", "slots", "promptTemplate", "warnings",
    "promptCoverage", "runtimeSummary", "selfReview",
    "formalPreview", "objectSha256", "approvedImageSha256", "ruleVersion", "revision"
  ],
  "properties": {
    "state": {"const": "awaiting_json_approval"},
    "approvedImage": {"type": "object"},
    "frozenCandidateKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$"},
    "registry": {"type": "object"},
    "assetState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "previewUri", "plannedImmutableUrl"],
      "properties": {
        "status": {"const": "planned_not_uploaded"},
        "previewUri": {"type": "string", "minLength": 1},
        "plannedImmutableUrl": {"type": "string", "format": "uri"}
      }
    },
    "analysisSummary": {"type": "object"},
    "templateValue": {"type": "object"},
    "titleEvidence": {"type": "object"},
    "tagEvidence": {"type": "object"},
    "slotCards": {"type": "object"},
    "copy": {"type": "object"},
    "slots": {"type": "array", "minItems": 1},
    "promptTemplate": {"type": "string", "minLength": 1},
    "warnings": {"type": "array"},
    "promptCoverage": {"type": "object"},
    "runtimeSummary": {"type": "object"},
    "selfReview": {"type": "object"},
    "formalPreview": {"type": "object"},
    "objectSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approvedImageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ruleVersion": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1}
  }
}
